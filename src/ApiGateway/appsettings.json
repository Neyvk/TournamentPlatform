{
  "ReverseProxy": {
    "Routes": {
      "players": {
        "ClusterId": "players",
        "Match": { "Path": "/api/v1/players/{**catch-all}" }
      },
      "teams": {
        "ClusterId": "players",
        "Match": { "Path": "/api/v1/teams/{**catch-all}" }
      },
      "tournaments": {
        "ClusterId": "tournaments",
        "Match": { "Path": "/api/v1/tournaments/{**catch-all}" }
      },
      "matches": {
        "ClusterId": "matches",
        "Match": { "Path": "/api/v1/matches/{**catch-all}" }
      },
      "ratings": {
        "ClusterId": "rating",
        "Match": { "Path": "/api/v1/ratings/{**catch-all}" }
      }
    },
    "Clusters": {
      "players": { "Destinations": { "local": { "Address": "http://localhost:8082/" } } },
      "tournaments": { "Destinations": { "local": { "Address": "http://localhost:8083/" } } },
      "matches": { "Destinations": { "local": { "Address": "http://localhost:8084/" } } },
      "rating": { "Destinations": { "local": { "Address": "http://localhost:8085/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

